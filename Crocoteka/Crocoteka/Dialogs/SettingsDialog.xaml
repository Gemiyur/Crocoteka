<Window x:Class="Crocoteka.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crocoteka.Dialogs"
        mc:Ignorable="d"
        Title="Настройки"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="ButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="75" />
                <Setter Property="Height" Value="25" />
            </Style>
            <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10,0,10,0">
            <CheckBox x:Name="NavPanelAuthorFullNameCheckBox"
                              Content="В панели навигации отображать полные имена авторов"
                              Style="{StaticResource CheckBoxStyle}" />
            <CheckBox x:Name="BookListAuthorFullNameCheckBox"
                              Content="В списке книг отображать полные имена авторов"
                              Style="{StaticResource CheckBoxStyle}" />
            <CheckBox x:Name="BookInfoAuthorFullNameCheckBox"
                              Content="В окне информации о книге отображать полные имена авторов"
                              Style="{StaticResource CheckBoxStyle}" />
            <CheckBox x:Name="CascadeGenreDeleteCheckBox"
                              Content="Разрешить удаление жанров, которые есть у книг"
                              Style="{StaticResource CheckBoxStyle}" />
            <CheckBox x:Name="SaveMainWindowLocationCheckBox"
                              Content="Сохранять положение и размер окна приложения"
                              Style="{StaticResource CheckBoxStyle}" />
            <CheckBox x:Name="SaveInfoWindowsSizeCheckBox"
                              Content="Сохранять размеры окон информации о книге, авторе и серии"
                              Style="{StaticResource CheckBoxStyle}" />
            <CheckBox x:Name="SaveEditorsSizeCheckBox"
                              Content="Сохранять размеры окон редакторов книги, автора и серии"
                              Style="{StaticResource CheckBoxStyle}" />
            <CheckBox x:Name="SaveFindFilesWindowLocationCheckBox"
                              Content="Сохранять положение и размер окна поиска файлов книг"
                              Style="{StaticResource CheckBoxStyle}" />
            <CheckBox x:Name="SaveNotInLibraryStateCheckBox"
                              Content="Сохранять состояние флажка «Нет в библиотеке» в окне поиска файлов книг"
                              Style="{StaticResource CheckBoxStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="ResetButton" Content="Сброс"
                    Style="{StaticResource ButtonStyle}"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    ToolTip="Установить настройки по-умолчанию"
                    Click="ResetButton_Click" />
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,10,0,0">
                <Button x:Name="SaveButton" Content="Сохранить"
                        Style="{StaticResource ButtonStyle}"
                        Click="SaveButton_Click" />
                <Button x:Name="CancelButton" Content="Отмена"
                        Style="{StaticResource ButtonStyle}"
                        Margin="10,0,0,0"
                        Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
